local function cleanup()
    if not alive then return end
    alive = false

    for player in pairs(Visuals) do
        destroyVisual(player)
    end

    for player in pairs(playerConnections) do
        clearPlayerConnections(player)
    end

    disconnectList(connections)

    if Gui and Gui.Parent then
        Gui:Destroy()
    end

    if OverlayGui and OverlayGui.Parent then
        OverlayGui:Destroy()
    end

    ENV.__MMB_UNIVERSAL_ESP_CLEANUP = nil
end

ENV.__MMB_UNIVERSAL_ESP_CLEANUP = cleanup

