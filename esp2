local function destroyDrawing(object)
    if not object then return end

    pcall(function()
        object.Visible = false
    end)

    pcall(function()
        object:Remove()
    end)
end

local function destroyVisual(player)
    local visual = Visuals[player]
    if not visual then return end

    if visual.backend == "drawing" then
        destroyDrawing(visual.text)
        destroyDrawing(visual.tracer)
    else
        if visual.billboard then
            pcall(function()
                visual.billboard:Destroy()
            end)
        end

        if visual.tracer then
            pcall(function()
                visual.tracer:Destroy()
            end)
        end
    end

    Visuals[player] = nil
end

local function makeNativeVisual(player)
    local billboard = Instance.new("BillboardGui")
    billboard.Name = "MMB_ESP_" .. tostring(player.UserId)
    billboard.Size = UDim2.fromOffset(300, 42)
    billboard.StudsOffset = Vector3.new(0, 3.2, 0)
    billboard.AlwaysOnTop = true
    billboard.LightInfluence = 0
    billboard.MaxDistance = 100000
    billboard.Enabled = false
    billboard.Parent = PlayerGui

    local label = Instance.new("TextLabel")
    label.Size = UDim2.fromScale(1, 1)
    label.BackgroundTransparency = 1
    label.Font = Enum.Font.GothamSemibold
    label.TextSize = UIS.TouchEnabled and 13 or 14
    label.TextColor3 = COLOR_OTHER
    label.TextStrokeTransparency = 0.25
    label.TextStrokeColor3 = Color3.new(0, 0, 0)
    label.TextWrapped = false
    label.Text = ""
    label.Parent = billboard

    local tracer = Instance.new("Frame")
    tracer.Name = "Tracer"
    tracer.AnchorPoint = Vector2.new(0.5, 0.5)
    tracer.BorderSizePixel = 0
    tracer.BackgroundColor3 = COLOR_OTHER
    tracer.Visible = false
    tracer.ZIndex = 20
    tracer.Parent = NativeTracerLayer

    return {
        backend = "native",
        billboard = billboard,
        label = label,
        tracer = tracer,
    }
end

local function makeDrawingVisual()
    local text = DrawingAPI.new("Text")
    text.Center = true
    text.Outline = true
    text.Size = UIS.TouchEnabled and 13 or 14
    text.Visible = false

    local tracer = DrawingAPI.new("Line")
    tracer.Thickness = UIS.TouchEnabled and 1.5 or 1
    tracer.Visible = false

    return {
        backend = "drawing",
        text = text,
        tracer = tracer,
    }
end

local function getVisual(player)
    local visual = Visuals[player]
    if visual then
        return visual
    end

    if DrawingSupported then
        local ok, result = pcall(makeDrawingVisual)
        if ok and result then
            visual = result
        else
            DrawingSupported = false
        end
    end

    if not visual then
        visual = makeNativeVisual(player)
    end

    Visuals[player] = visual
    return visual
end

local function hideVisual(visual)
    if not visual then return end

    if visual.backend == "drawing" then
        visual.text.Visible = false
        visual.tracer.Visible = false
    else
        visual.billboard.Enabled = false
        visual.tracer.Visible = false
    end
end

local function setNativeTracer(frame, fromPoint, toPoint, color)
    local delta = toPoint - fromPoint
    local length = delta.Magnitude

    if length <= 1 then
        frame.Visible = false
        return
    end

    frame.Position = UDim2.fromOffset(
        (fromPoint.X + toPoint.X) * 0.5,
        (fromPoint.Y + toPoint.Y) * 0.5
    )

    frame.Size = UDim2.fromOffset(
        length,
        UIS.TouchEnabled and 2 or 1.5
    )

    frame.Rotation =
        math.deg(
            math.atan2(delta.Y, delta.X)
        )

    frame.BackgroundColor3 = color
    frame.Visible = true
end

local function buildEspText(player, character, humanoid, distance, className)
    local parts = {}

    table.insert(parts, player.Name)

    local animalName = character:GetAttribute("AnimalName")
    if animalName ~= nil and tostring(animalName) ~= "" then
        table.insert(parts, tostring(animalName))
    elseif Settings.showTeam then
        local teamName = teamNameOf(player)
        if teamName then
            table.insert(parts, teamName)
        end
    end

    if Settings.showDistance then
        table.insert(parts, tostring(distance) .. "m")
    end

    if Settings.showHealth then
        table.insert(
            parts,
            "HP "
                .. tostring(math.ceil(humanoid.Health))
                .. "/"
                .. tostring(math.ceil(humanoid.MaxHealth))
        )
    end

    if className == "whitelist" and isFriendWhitelisted(player) then
        table.insert(parts, "FRIEND")
    end

    return table.concat(parts, " | ")
end

