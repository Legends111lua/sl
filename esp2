-- Status refresh is intentionally slow.
task.spawn(function()
    while alive do
        local targetCount = 0
        local whitelistCount = 0
        local friendCount = 0

        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer then
                if isTarget(player) then
                    targetCount = targetCount + 1
                end

                if isWhitelisted(player) then
                    whitelistCount = whitelistCount + 1
                end

                if isFriendWhitelisted(player) then
                    friendCount = friendCount + 1
                end
            end
        end

        if StatusBody and StatusBody.Parent then
            StatusBody.Text =
                string.format(
                    "%s backend • %d targets • %d whitelisted • %d Roblox friends • %d FPS cap",
                    DrawingSupported and "Drawing" or "Native",
                    targetCount,
                    whitelistCount,
                    friendCount,
                    renderFPS()
                )
        end

        task.wait(0.75)
    end
end)

-- Mobile/desktop dragging.
local dragging = false
local dragStart = nil
local windowStart = nil

safeConnect(Header.InputBegan, function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then

        dragging = true
        dragStart = input.Position
        windowStart = Window.Position
    end
end)

safeConnect(Header.InputEnded, function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then

        dragging = false
    end
end)

safeConnect(UIS.InputChanged, function(input)
    if not dragging or not dragStart or not windowStart then
        return
    end

    if input.UserInputType ~= Enum.UserInputType.MouseMovement
        and input.UserInputType ~= Enum.UserInputType.Touch then
        return
    end

    local delta = input.Position - dragStart

    Window.Position =
        UDim2.new(
            windowStart.X.Scale,
            windowStart.X.Offset + delta.X,
            windowStart.Y.Scale,
            windowStart.Y.Offset + delta.Y
        )
end)

