    page.BackgroundTransparency = 1
    page.BorderSizePixel = 0
    page.ScrollBarThickness = UIS.TouchEnabled and 4 or 3
    page.ScrollBarImageColor3 = COLOR_ACCENT
    page.CanvasSize = UDim2.new()
