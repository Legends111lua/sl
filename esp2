-- PLAYER CACHE
-- ============================================================

local function clearPlayerConnections(player)
    local list = playerConnections[player]
    if list then
        disconnectList(list)
        playerConnections[player] = nil
    end
end

local function updatePlayerCharacter(player)
    if player == LocalPlayer then return end

    local character = player.Character
    PlayerState[player] = PlayerState[player] or {}

    local state = PlayerState[player]
    state.character = character
    state.root = characterRoot(character)
    state.humanoid = characterHumanoid(character)
end

local function bindPlayer(player)
    if player == LocalPlayer then return end

    clearPlayerConnections(player)
    playerConnections[player] = {}

    updatePlayerCharacter(player)
    refreshFriend(player)

    local function add(connection)
        if connection then
            table.insert(playerConnections[player], connection)
        end
    end

    local ok1, c1 = pcall(function()
        return player.CharacterAdded:Connect(function()
            task.defer(function()
                updatePlayerCharacter(player)
            end)
        end)
    end)
    if ok1 then add(c1) end

    local ok2, c2 = pcall(function()
        return player.CharacterRemoving:Connect(function()
            local state = PlayerState[player]
            if state then
                state.character = nil
                state.root = nil
                state.humanoid = nil
            end
            hideVisual(Visuals[player])
        end)
    end)
    if ok2 then add(c2) end

    local ok3, c3 = pcall(function()
        return player:GetPropertyChangedSignal("Team"):Connect(function()
            for _, refresh in ipairs(selectorRefreshers) do
                pcall(refresh)
            end
        end)
    end)
    if ok3 then add(c3) end
end

local function unbindPlayer(player)
    clearPlayerConnections(player)
    PlayerState[player] = nil
    FriendCache[player.UserId] = nil
    destroyVisual(player)

    Selection.targetPlayers[player.UserId] = nil
    Selection.whitelistPlayers[player.UserId] = nil

    for _, refresh in ipairs(selectorRefreshers) do
        pcall(refresh)
    end
end

for _, player in ipairs(Players:GetPlayers()) do
    bindPlayer(player)
end

safeConnect(Players.PlayerAdded, function(player)
    bindPlayer(player)
    for _, refresh in ipairs(selectorRefreshers) do
        pcall(refresh)
    end
end)

safeConnect(Players.PlayerRemoving, function(player)
    unbindPlayer(player)
end)

safeConnect(Teams.ChildAdded, function()
    for _, refresh in ipairs(selectorRefreshers) do
        pcall(refresh)
    end
end)

safeConnect(Teams.ChildRemoved, function()
    for _, refresh in ipairs(selectorRefreshers) do
        pcall(refresh)
    end
end)

-- ============================================================
-- OPTIMIZED ESP LOOP
-- ============================================================

local renderAccumulator = 0
local function renderFPS()
    local count = #Players:GetPlayers()

    if UIS.TouchEnabled then
        if count > 40 then return 18 end
        if count > 20 then return 22 end
        return 26
    end

    if count > 60 then return 20 end
    if count > 35 then return 24 end
    return 30
end

safeConnect(RunService.RenderStepped, function(dt)
    if not alive then return end

    renderAccumulator = renderAccumulator + dt

    local interval = 1 / renderFPS()
    if renderAccumulator < interval then
        return
    end

    renderAccumulator = 0

    if not Settings.esp then
        for _, visual in pairs(Visuals) do
            hideVisual(visual)
        end
        return
    end

    local camera = workspace.CurrentCamera
    if not camera then return end

    local localRoot = characterRoot(LocalPlayer.Character)
    local viewport = camera.ViewportSize
    local tracerOrigin = Vector2.new(
        viewport.X * 0.5,
        viewport.Y
    )

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local wanted = shouldShow(player)
            local visual = Visuals[player]

            if not wanted then
                if visual then
                    hideVisual(visual)
                end
            else
                if not visual then
                    visual = getVisual(player)
                end

                local state = PlayerState[player]

                if not state then
                    updatePlayerCharacter(player)
                    state = PlayerState[player]
                end

                local character = state and state.character
                local root = state and state.root
                local humanoid = state and state.humanoid

                if character and (
                    not root
                    or not root.Parent
                    or not humanoid
                    or not humanoid.Parent
                ) then
                    updatePlayerCharacter(player)
                    state = PlayerState[player]
                    character = state and state.character
                    root = state and state.root
                    humanoid = state and state.humanoid
                end

                local visible =
                    character ~= nil
                    and root ~= nil
                    and humanoid ~= nil
                    and humanoid.Health > 0

                if not visible then
                    hideVisual(visual)
                else
                local className, color = classification(player)

                local distance = 0
                if localRoot then
                    distance = math.floor(
                        (localRoot.Position - root.Position).Magnitude
                        + 0.5
                    )
                end

                local text =
                    buildEspText(
                        player,
                        character,
                        humanoid,
                        distance,
                        className
                    )

                if visual.backend == "drawing" then
                    local point, onScreen =
                        camera:WorldToViewportPoint(
                            root.Position + Vector3.new(0, 3, 0)
                        )

                    if onScreen and point.Z > 0 then
                        visual.text.Text = text
                        visual.text.Position =
                            Vector2.new(point.X, point.Y)
                        visual.text.Color = color
                        visual.text.Visible = true

                        if Settings.tracers then
                            visual.tracer.From = tracerOrigin
                            visual.tracer.To =
                                Vector2.new(point.X, point.Y)
                            visual.tracer.Color = color
                            visual.tracer.Visible = true
                        else
                            visual.tracer.Visible = false
                        end
                    else
                        visual.text.Visible = false
                        visual.tracer.Visible = false
                    end
                else
                    visual.billboard.Adornee = root
                    visual.label.Text = text
                    visual.label.TextColor3 = color
                    visual.billboard.Enabled = true

                    if Settings.tracers then
                        local point, onScreen =
                            camera:WorldToViewportPoint(root.Position)

                        if onScreen and point.Z > 0 then
                            setNativeTracer(
                                visual.tracer,
                                tracerOrigin,
                                Vector2.new(point.X, point.Y),
                                color
                            )
                        else
                            visual.tracer.Visible = false
                        end
                    else
                        visual.tracer.Visible = false
                    end
                end
            end
        end
    end
end
end)

