local function createSelector(
    parent,
    titleText,
    playerSet,
    teamSet,
    oppositePlayerSet,
    oppositeTeamSet,
    order
)
    local container = makeCard(
        parent,
        UIS.TouchEnabled and 460 or 410,
        order
    )

    local title = Instance.new("TextLabel")
    title.BackgroundTransparency = 1
    title.Position = UDim2.fromOffset(12, 7)
    title.Size = UDim2.new(1, -92, 0, 22)
    title.Font = Enum.Font.GothamSemibold
    title.Text = titleText
    title.TextColor3 = COLOR_ACCENT
    title.TextSize = UIS.TouchEnabled and 13 or 12
    title.TextXAlignment = Enum.TextXAlignment.Left
    title.Parent = container

    local clear = Instance.new("TextButton")
    clear.AnchorPoint = Vector2.new(1, 0)
    clear.Position = UDim2.new(1, -10, 0, 7)
    clear.Size = UDim2.fromOffset(66, UIS.TouchEnabled and 26 or 22)
    clear.BackgroundColor3 = COLOR_PANEL_ALT
    clear.BorderSizePixel = 0
    clear.Font = Enum.Font.GothamBold
    clear.Text = "CLEAR"
    clear.TextColor3 = COLOR_SUBTEXT
    clear.TextSize = 9
    clear.AutoButtonColor = false
    clear.Parent = container

    local cc = Instance.new("UICorner")
    cc.CornerRadius = UDim.new(0, 6)
    cc.Parent = clear

    local search = Instance.new("TextBox")
    search.Position = UDim2.fromOffset(10, 38)
    search.Size = UDim2.new(1, -20, 0, UIS.TouchEnabled and 38 or 34)
    search.BackgroundColor3 = COLOR_PANEL_ALT
    search.BorderSizePixel = 0
    search.ClearTextOnFocus = false
    search.PlaceholderText = "Search player or team..."
    search.PlaceholderColor3 = COLOR_SUBTEXT
    search.Text = ""
    search.TextColor3 = COLOR_TEXT
    search.Font = Enum.Font.Gotham
    search.TextSize = UIS.TouchEnabled and 13 or 12
    search.Parent = container

    local sc = Instance.new("UICorner")
    sc.CornerRadius = UDim.new(0, 8)
    sc.Parent = search

    local list = Instance.new("ScrollingFrame")
    list.Position = UDim2.fromOffset(
        10,
        UIS.TouchEnabled and 84 or 80
    )
    list.Size = UDim2.new(
        1,
        -20,
        1,
        -(UIS.TouchEnabled and 94 or 90)
    )
    list.BackgroundTransparency = 1
    list.BorderSizePixel = 0
    list.ScrollBarThickness = UIS.TouchEnabled and 4 or 3
    list.ScrollBarImageColor3 = COLOR_ACCENT
    list.CanvasSize = UDim2.new()
    list.AutomaticCanvasSize = Enum.AutomaticSize.Y
    list.Parent = container

    local layout = Instance.new("UIListLayout")
    layout.Padding = UDim.new(0, UIS.TouchEnabled and 6 or 4)
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Parent = list

    local function addRow(text, selected, friendWL, callback, rowOrder)
        local row = Instance.new("TextButton")
        row.Size = UDim2.new(
            1,
            -4,
            0,
            UIS.TouchEnabled and 42 or 32
        )
        row.LayoutOrder = rowOrder or 0
        row.BackgroundColor3 =
            selected and Color3.fromRGB(53, 39, 78)
            or COLOR_PANEL_ALT
        row.BorderSizePixel = 0
        row.AutoButtonColor = false
        row.Font = Enum.Font.GothamMedium
        row.TextSize = UIS.TouchEnabled and 12 or 11
        row.TextColor3 =
            selected and COLOR_ACCENT or COLOR_TEXT
        row.TextXAlignment = Enum.TextXAlignment.Left
        row.Text =
            (selected and "●  " or "○  ")
            .. text
            .. (friendWL and "   [FRIEND WL]" or "")
        row.Parent = list

        local rc = Instance.new("UICorner")
        rc.CornerRadius = UDim.new(0, 7)
        rc.Parent = row

        local padding = Instance.new("UIPadding")
        padding.PaddingLeft = UDim.new(0, 10)
        padding.PaddingRight = UDim.new(0, 8)
        padding.Parent = row

        safeConnect(row.Activated, callback)
    end

    local function refresh()
        if not alive or not list.Parent then
            return
        end

        for _, child in ipairs(list:GetChildren()) do
            if child:IsA("GuiButton") then
                child:Destroy()
            end
        end

        local query = string.lower(search.Text or "")

        local sortedPlayers = {}
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer then
                table.insert(sortedPlayers, player)
            end
        end

        table.sort(sortedPlayers, function(a, b)
            return string.lower(a.Name) < string.lower(b.Name)
        end)

        local orderIndex = 1

        for _, player in ipairs(sortedPlayers) do
            local label =
                "PLAYER  "
                .. player.DisplayName
                .. " (@"
                .. player.Name
                .. ")"

            local matches =
                query == ""
                or string.find(
                    string.lower(label),
                    query,
                    1,
                    true
                ) ~= nil

            if matches then
                local uid = player.UserId
                local selected = playerSet[uid] == true

                addRow(
                    label,
                    selected,
                    isFriendWhitelisted(player),
                    function()
                        local wasSelected = playerSet[uid] == true

                        playerSet[uid] = nil
                        if oppositePlayerSet then
                            oppositePlayerSet[uid] = nil
                        end

                        if not wasSelected then
                            playerSet[uid] = true
                        end

                        for _, selectorRefresh in ipairs(selectorRefreshers) do
                            pcall(selectorRefresh)
                        end
                    end,
                    orderIndex
                )

                orderIndex = orderIndex + 1
            end
        end

        local teamNames = {}

        for _, team in ipairs(Teams:GetTeams()) do
            teamNames[team.Name] = true
        end

        for _, player in ipairs(Players:GetPlayers()) do
            if player.Team then
                teamNames[player.Team.Name] = true
            end
        end

        local sortedTeams = {}
        for teamName in pairs(teamNames) do
            table.insert(sortedTeams, teamName)
        end

        table.sort(sortedTeams, function(a, b)
            return string.lower(a) < string.lower(b)
        end)

        for _, teamName in ipairs(sortedTeams) do
            local label = "TEAM  " .. teamName
            local matches =
                query == ""
                or string.find(
                    string.lower(label),
                    query,
                    1,
                    true
                ) ~= nil

            if matches then
                local selected = teamSet[teamName] == true

                addRow(
                    label,
                    selected,
                    false,
                    function()
                        local wasSelected =
                            teamSet[teamName] == true

                        teamSet[teamName] = nil
                        if oppositeTeamSet then
                            oppositeTeamSet[teamName] = nil
                        end

                        if not wasSelected then
                            teamSet[teamName] = true
                        end

                        for _, selectorRefresh in ipairs(selectorRefreshers) do
                            pcall(selectorRefresh)
                        end
                    end,
                    orderIndex
                )

                orderIndex = orderIndex + 1
            end
        end
    end

    table.insert(selectorRefreshers, refresh)

    safeConnect(search:GetPropertyChangedSignal("Text"), refresh)

    safeConnect(clear.Activated, function()
        clearSet(playerSet)
        clearSet(teamSet)

        for _, selectorRefresh in ipairs(selectorRefreshers) do
            pcall(selectorRefresh)
        end
    end)

    refresh()
    return refresh
end

