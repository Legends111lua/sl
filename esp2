local COLOR_BG = Color3.fromRGB(18, 19, 25)
local COLOR_PANEL = Color3.fromRGB(26, 27, 35)
local COLOR_PANEL_ALT = Color3.fromRGB(32, 33, 43)
local COLOR_ACCENT = Color3.fromRGB(135, 91, 255)
local COLOR_TEXT = Color3.fromRGB(240, 240, 246)
local COLOR_SUBTEXT = Color3.fromRGB(166, 168, 183)
local COLOR_TARGET = Color3.fromRGB(255, 82, 92)
local COLOR_WHITELIST = Color3.fromRGB(81, 221, 134)
local COLOR_OTHER = Color3.fromRGB(235, 235, 240)
local COLOR_OFF = Color3.fromRGB(54, 55, 66)

local function keep(connection)
    if connection then
        table.insert(connections, connection)
    end
    return connection
end

local function safeConnect(signal, callback)
    local ok, connection = pcall(function()
        return signal:Connect(callback)
    end)
    if ok then
        return keep(connection)
    end
    return nil
end

local function disconnectList(list)
    for _, connection in ipairs(list) do
        pcall(function()
            connection:Disconnect()
        end)
    end
    table.clear(list)
end

local function characterRoot(character)
    if not character then return nil end
    return character:FindFirstChild("HumanoidRootPart")
        or character.PrimaryPart
        or character:FindFirstChildWhichIsA("BasePart")
end

local function characterHumanoid(character)
    return character and character:FindFirstChildOfClass("Humanoid")
end

local function teamNameOf(player)
    return player and player.Team and player.Team.Name or nil
end

local function isSelected(player, playerSet, teamSet)
    if not player then return false end

    if playerSet[player.UserId] == true then
        return true
    end

    local teamName = teamNameOf(player)
    return teamName ~= nil and teamSet[teamName] == true
end

local function isFriendWhitelisted(player)
    return Settings.friendWhitelist
        and FriendCache[player.UserId] == true
end

local function isWhitelisted(player)
    if not player or player == LocalPlayer then
        return false
    end

    return isFriendWhitelisted(player)
        or isSelected(
            player,
            Selection.whitelistPlayers,
            Selection.whitelistTeams
        )
end

local function isTarget(player)
    if not player or player == LocalPlayer then
        return false
    end

    if isWhitelisted(player) then
        return false
    end

    return isSelected(
        player,
        Selection.targetPlayers,
        Selection.targetTeams
    )
end

local function classification(player)
    if isWhitelisted(player) then
        return "whitelist", COLOR_WHITELIST
    end

    if isTarget(player) then
        return "target", COLOR_TARGET
    end

    return "other", COLOR_OTHER
end

local function shouldShow(player)
    if not Settings.esp then
        return false
    end

    if Settings.showAllPlayers then
        return true
    end

    return isTarget(player) or isWhitelisted(player)
end

local function refreshFriend(player)
    if not player or player == LocalPlayer then return end

    task.spawn(function()
        local ok, result = pcall(function()
            return LocalPlayer:IsFriendsWith(player.UserId)
        end)

        if ok then
            FriendCache[player.UserId] = result == true
        else
            FriendCache[player.UserId] = false
        end

        for _, refresh in ipairs(selectorRefreshers) do
            pcall(refresh)
        end
    end)
end

local function refreshAllFriends()
    if not Settings.friendWhitelist then
        return
    end

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            refreshFriend(player)
        end
    end
end

