local function createCompactToggle(text, setting)
	local button = Instance.new("TextButton")
	button.AutoButtonColor = false
	button.Size = UDim2.new(1, 0, 0, 32)
	button.BackgroundColor3 = Color3.fromRGB(32, 33, 38)
	button.BorderSizePixel = 0
	button.Text = ""
	button.Parent = body

	Instance.new("UICorner", button).CornerRadius = UDim.new(0, 7)

	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Position = UDim2.fromOffset(10, 0)
	label.Size = UDim2.new(1, -58, 1, 0)
	label.Font = Enum.Font.Gotham
	label.Text = text
	label.TextColor3 = Color3.fromRGB(225, 225, 230)
	label.TextSize = 11
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.Parent = button

	local indicator = Instance.new("Frame")
	indicator.AnchorPoint = Vector2.new(1, 0.5)
	indicator.Position = UDim2.new(1, -8, 0.5, 0)
	indicator.Size = UDim2.fromOffset(36, 18)
	indicator.BorderSizePixel = 0
	indicator.Parent = button

	Instance.new("UICorner", indicator).CornerRadius = UDim.new(1, 0)

	local dot = Instance.new("Frame")
	dot.AnchorPoint = Vector2.new(0, 0.5)
	dot.Size = UDim2.fromOffset(12, 12)
	dot.BorderSizePixel = 0
	dot.BackgroundColor3 = Color3.fromRGB(240, 240, 245)
	dot.Parent = indicator

	Instance.new("UICorner", dot).CornerRadius = UDim.new(1, 0)

	local function render()
		local enabled = Settings[setting]

		indicator.BackgroundColor3 = enabled
			and Color3.fromRGB(65, 185, 105)
			or Color3.fromRGB(60, 61, 68)

		dot.Position = enabled
			and UDim2.new(1, -15, 0.5, 0)
			or UDim2.new(0, 3, 0.5, 0)
	end

	button.Activated:Connect(function()
		Settings[setting] = not Settings[setting]
		render()
	end)

	render()

	return button
end

