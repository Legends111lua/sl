	Tracer = true,

	TeamColors = true,
	HideTeam = false,
}

local IS_MOBILE =
	UserInputService.TouchEnabled
	and not UserInputService.KeyboardEnabled

local UPDATE_INTERVAL = IS_MOBILE and (1 / 30) or (1 / 60)

local Connections = {}
local EspObjects = {}

local function addConnection(connection)
	table.insert(Connections, connection)
	return connection
end

local function removeDrawing(object)
	if not object then
		return
	end

	pcall(function()
		object.Visible = false
		object:Remove()
	end)
end

local function hideObjects(objects)
	if not objects then
		return
	end

	objects.Text.Visible = false
	objects.Tracer.Visible = false
	objects.Box.Visible = false
	objects.BoxOutline.Visible = false
	objects.Health.Visible = false
	objects.HealthBackground.Visible = false
end

local function removeEsp(player)
	local objects = EspObjects[player]

	if not objects then
		return
	end

	removeDrawing(objects.Text)
	removeDrawing(objects.Tracer)
	removeDrawing(objects.Box)
	removeDrawing(objects.BoxOutline)
	removeDrawing(objects.Health)
	removeDrawing(objects.HealthBackground)

	EspObjects[player] = nil
end

local function removeAllEsp()
	for player in pairs(EspObjects) do
		removeEsp(player)
	end
end

local function createEsp(player)
	if EspObjects[player] then
		return EspObjects[player]
	end

	if not Drawing or not Drawing.new then
		return nil
	end

	local text = Drawing.new("Text")
	text.Center = true
	text.Outline = true
	text.Size = IS_MOBILE and 12 or 14
	text.Visible = false
	text.Transparency = 1

	local tracer = Drawing.new("Line")
	tracer.Thickness = IS_MOBILE and 1.5 or 1
	tracer.Transparency = 1
	tracer.Visible = false

	local boxOutline = Drawing.new("Square")
	boxOutline.Filled = false
	boxOutline.Thickness = 3
	boxOutline.Color = Color3.new(0, 0, 0)
	boxOutline.Transparency = 0.8
	boxOutline.Visible = false

	local box = Drawing.new("Square")
	box.Filled = false
	box.Thickness = IS_MOBILE and 2 or 1.5
	box.Transparency = 1
	box.Visible = false

	local healthBackground = Drawing.new("Line")
	healthBackground.Thickness = 5
	healthBackground.Color = Color3.new(0, 0, 0)
	healthBackground.Transparency = 0.8
	healthBackground.Visible = false

	local health = Drawing.new("Line")
	health.Thickness = 3
	health.Transparency = 1
	health.Visible = false

	local objects = {
		Text = text,
		Tracer = tracer,

		Box = box,
		BoxOutline = boxOutline,

		Health = health,
		HealthBackground = healthBackground,
	}

	EspObjects[player] = objects

	return objects
end

local function getPlayerColor(player)
	if Settings.TeamColors and player.Team then
		return player.TeamColor.Color
	end

	return Color3.fromRGB(255, 95, 95)
end

local function getAnimalName(character)
	return character:GetAttribute("AnimalName")
		or character:GetAttribute("CharacterName")
		or character.Name
		or "Unknown"
end

local function getScreenBounds(character, camera)
	local success, boundingCFrame, boundingSize = pcall(function()
		local cf, size = character:GetBoundingBox()
		return cf, size
	end)

	if not success or not boundingCFrame or not boundingSize then
		return nil
	end

	local half = boundingSize / 2

	local corners = {
		Vector3.new(-half.X, -half.Y, -half.Z),
		Vector3.new(-half.X, -half.Y, half.Z),
		Vector3.new(-half.X, half.Y, -half.Z),
		Vector3.new(-half.X, half.Y, half.Z),

		Vector3.new(half.X, -half.Y, -half.Z),
		Vector3.new(half.X, -half.Y, half.Z),
		Vector3.new(half.X, half.Y, -half.Z),
		Vector3.new(half.X, half.Y, half.Z),
	}

	local minX = math.huge
	local minY = math.huge
	local maxX = -math.huge
	local maxY = -math.huge

	for _, offset in ipairs(corners) do
		local worldPosition = boundingCFrame:PointToWorldSpace(offset)
		local screenPosition = camera:WorldToViewportPoint(worldPosition)

		if screenPosition.Z <= 0 then
			return nil
		end

		minX = math.min(minX, screenPosition.X)
		minY = math.min(minY, screenPosition.Y)

		maxX = math.max(maxX, screenPosition.X)
		maxY = math.max(maxY, screenPosition.Y)
	end

	if minX == math.huge then
		return nil
	end

	return {
		X = minX,
		Y = minY,

		Width = math.max(maxX - minX, 2),
		Height = math.max(maxY - minY, 2),

		Right = maxX,
		Bottom = maxY,
	}
end

