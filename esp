local function countSelections()
	local players = 0
	local teams = 0

	for _ in pairs(Settings.SelectedPlayers) do
		players += 1
	end

	for _ in pairs(Settings.SelectedTeams) do
		teams += 1
	end

	return players, teams
end

local function updateSelectionStatus()
	local players, teams = countSelections()

	selectionStatus.Text = string.format(
		"%d jogador(es) • %d team(s) selecionado(s)",
		players,
		teams
	)

	if players + teams > 0 then
		selectButton.Text = string.format(
			"Selecionar foco  [%d]",
			players + teams
		)
	else
		selectButton.Text = "Selecionar foco"
	end
end

