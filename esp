local function cleanup()
	for _, connection in ipairs(connections) do
		pcall(function()
			connection:Disconnect()
		end)
	end

	table.clear(connections)

	for player in pairs(espObjects) do
		removeEsp(player)
	end

	if gui then
		gui:Destroy()
	end

	shared.MMBFocusESP_Cleanup = nil
end

shared.MMBFocusESP_Cleanup = cleanup
shared.MMBFocusESP = {
	Settings = Settings,
	Cleanup = cleanup,
}

