local function connect(signal)
	table.insert(connections, signal)
	return signal
end

local function removeDrawing(object)
	if object then
		pcall(function()
			object.Visible = false
			object:Remove()
		end)
	end
end

local function hideEsp(objects)
	if not objects then return end

	for _, object in pairs(objects) do
		pcall(function()
			object.Visible = false
		end)
	end
end

local function removeEsp(player)
	local objects = espObjects[player]
	if not objects then return end

	for _, object in pairs(objects) do
		removeDrawing(object)
	end

	espObjects[player] = nil
end

local function createEsp(player)
	if espObjects[player] then
		return espObjects[player]
	end

	if not Drawing or not Drawing.new then
		return
	end

	local text = Drawing.new("Text")
	text.Center = true
	text.Outline = true
	text.Size = IS_MOBILE and 12 or 14
	text.Visible = false

	local tracer = Drawing.new("Line")
	tracer.Thickness = 1
	tracer.Visible = false

	local box = Drawing.new("Square")
	box.Filled = false
	box.Thickness = IS_MOBILE and 2 or 1.5
	box.Visible = false

	local boxOutline = Drawing.new("Square")
	boxOutline.Filled = false
	boxOutline.Thickness = 3
	boxOutline.Color = Color3.new(0, 0, 0)
	boxOutline.Transparency = 0.8
	boxOutline.Visible = false

	local health = Drawing.new("Line")
	health.Thickness = 3
	health.Visible = false

	local healthBackground = Drawing.new("Line")
	healthBackground.Thickness = 5
	healthBackground.Color = Color3.new(0, 0, 0)
	healthBackground.Transparency = 0.8
	healthBackground.Visible = false

	local objects = {
		Text = text,
		Tracer = tracer,
		Box = box,
		BoxOutline = boxOutline,
		Health = health,
		HealthBackground = healthBackground,
	}

	espObjects[player] = objects

	return objects
end

local function isFocused(player)
	if not Settings.FocusMode then
		return true
	end

	if Settings.SelectedPlayers[player.UserId] then
		return true
	end

	if player.Team and Settings.SelectedTeams[player.Team.Name] then
		return true
	end

	return false
end

local function hasFocusSelection()
	if next(Settings.SelectedPlayers) then
		return true
	end

	if next(Settings.SelectedTeams) then
		return true
	end

	return false
end

local function getColor(player)
	if Settings.SelectedPlayers[player.UserId]
		or player.Team and Settings.SelectedTeams[player.Team.Name] then

		return Color3.fromRGB(255, 90, 90)
	end

	if player.Team then
		return player.TeamColor.Color
	end

	return Color3.fromRGB(235, 235, 235)
end

local function getAnimalName(character)
	return character:GetAttribute("AnimalName")
		or character:GetAttribute("CharacterName")
		or character.Name
end

local function getBounds(character, camera)
	local success, cf, size = pcall(function()
		return character:GetBoundingBox()
	end)

	if not success or not cf or not size then
		return
	end

	local half = size / 2

	local points = {
		Vector3.new(-half.X, -half.Y, -half.Z),
		Vector3.new(-half.X, -half.Y, half.Z),
		Vector3.new(-half.X, half.Y, -half.Z),
		Vector3.new(-half.X, half.Y, half.Z),

		Vector3.new(half.X, -half.Y, -half.Z),
		Vector3.new(half.X, -half.Y, half.Z),
		Vector3.new(half.X, half.Y, -half.Z),
		Vector3.new(half.X, half.Y, half.Z),
	}

	local minX = math.huge
	local minY = math.huge
	local maxX = -math.huge
	local maxY = -math.huge

	for _, offset in ipairs(points) do
		local world = cf:PointToWorldSpace(offset)
		local screen = camera:WorldToViewportPoint(world)

		if screen.Z <= 0 then
			return
		end

		minX = math.min(minX, screen.X)
		minY = math.min(minY, screen.Y)

		maxX = math.max(maxX, screen.X)
		maxY = math.max(maxY, screen.Y)
	end

	return {
		X = minX,
		Y = minY,
		Right = maxX,
		Bottom = maxY,
		Width = maxX - minX,
		Height = maxY - minY,
	}
end

