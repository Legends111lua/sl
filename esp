local lastViewportX = 0

local function updateScale()
	local camera = workspace.CurrentCamera
	if not camera then return end

	local width = camera.ViewportSize.X

	if width == lastViewportX then
		return
	end

	lastViewportX = width

	if width <= 400 then
		scale.Scale = 0.82
	elseif width <= 600 then
		scale.Scale = 0.9
	elseif width <= 900 then
		scale.Scale = 0.95
	else
		scale.Scale = 1
	end
end

-- Render

local accumulator = 0

connect(RunService.RenderStepped:Connect(function(dt)
	accumulator += dt

	if accumulator < UPDATE_INTERVAL then
		return
	end

	accumulator = 0

	updateScale()

	local camera = workspace.CurrentCamera
	if not camera then return end

	local localCharacter = LocalPlayer.Character
	local localRoot = localCharacter
		and localCharacter:FindFirstChild("HumanoidRootPart")

	for _, player in ipairs(Players:GetPlayers()) do
		if player == LocalPlayer then
			continue
		end

		local objects = createEsp(player)
		if not objects then continue end

		if not Settings.Enabled then
			hideEsp(objects)
			continue
		end

		if Settings.FocusMode
			and hasFocusSelection()
			and not isFocused(player) then

			hideEsp(objects)
			continue
		end

		local character = player.Character
		local root = character
			and character:FindFirstChild("HumanoidRootPart")

		local humanoid = character
			and character:FindFirstChildOfClass("Humanoid")

		if not root
			or not humanoid
			or humanoid.Health <= 0 then

			hideEsp(objects)
			continue
		end

		local point, onScreen = camera:WorldToViewportPoint(root.Position)

		if not onScreen or point.Z <= 0 then
			hideEsp(objects)
			continue
		end

		local bounds = getBounds(character, camera)

		if not bounds then
			hideEsp(objects)
			continue
		end

		local color = getColor(player)

		local distance = localRoot
			and math.floor((localRoot.Position - root.Position).Magnitude)
			or 0

		local animal = getAnimalName(character)

		local hp = math.max(humanoid.Health, 0)
		local maxHp = math.max(humanoid.MaxHealth, 1)
		local hpRatio = math.clamp(hp / maxHp, 0, 1)

		objects.BoxOutline.Position = Vector2.new(
			bounds.X,
			bounds.Y
		)

		objects.BoxOutline.Size = Vector2.new(
			bounds.Width,
			bounds.Height
		)

		objects.Box.Position = objects.BoxOutline.Position
		objects.Box.Size = objects.BoxOutline.Size
		objects.Box.Color = color

		objects.BoxOutline.Visible = true
		objects.Box.Visible = true

		local healthX = bounds.X - 6

		objects.HealthBackground.From = Vector2.new(
			healthX,
			bounds.Y
		)

		objects.HealthBackground.To = Vector2.new(
			healthX,
			bounds.Bottom
		)

		objects.Health.From = Vector2.new(
			healthX,
			bounds.Bottom
		)

		objects.Health.To = Vector2.new(
			healthX,
			bounds.Bottom - bounds.Height * hpRatio
		)

		objects.Health.Color = Color3.new(
			1 - hpRatio,
			hpRatio,
			0.1
		)

		objects.HealthBackground.Visible = true
		objects.Health.Visible = true

		objects.Text.Text = string.format(
			"%s | %s | %dm | %d/%d HP",
			player.Name,
			tostring(animal),
			distance,
			math.ceil(hp),
			math.ceil(maxHp)
		)

		objects.Text.Position = Vector2.new(
			bounds.X + bounds.Width / 2,
			bounds.Y - 17
		)

		objects.Text.Color = color
		objects.Text.Visible = true

		objects.Tracer.From = Vector2.new(
			camera.ViewportSize.X / 2,
			camera.ViewportSize.Y
		)

		objects.Tracer.To = Vector2.new(
			bounds.X + bounds.Width / 2,
			bounds.Bottom
		)

		objects.Tracer.Color = color
		objects.Tracer.Visible = true
	end
end))

