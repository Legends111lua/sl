refreshSelector = function()
	for _, child in ipairs(list:GetChildren()) do
		if child ~= listLayout then
			child:Destroy()
		end
	end

	local query = string.lower(search.Text)

	addSection("JOGADORES")

	local playerList = Players:GetPlayers()

	table.sort(playerList, function(a, b)
		return string.lower(a.Name) < string.lower(b.Name)
	end)

	for _, player in ipairs(playerList) do
		if player ~= LocalPlayer then
			local name = player.DisplayName ~= player.Name
				and player.DisplayName .. "  (@" .. player.Name .. ")"
				or player.Name

			if query == ""
				or string.find(string.lower(name), query, 1, true) then

				addSelectionRow(
					name,
					Settings.SelectedPlayers[player.UserId] == true,
					function()
						if Settings.SelectedPlayers[player.UserId] then
							Settings.SelectedPlayers[player.UserId] = nil
						else
							Settings.SelectedPlayers[player.UserId] = true
						end

						refreshSelector()
					end
				)
			end
		end
	end

	addSection("TEAMS")

	local teamNames = {}

	for _, player in ipairs(Players:GetPlayers()) do
		if player.Team then
			teamNames[player.Team.Name] = true
		end
	end

	local sortedTeams = {}

	for teamName in pairs(teamNames) do
		table.insert(sortedTeams, teamName)
	end

	table.sort(sortedTeams)

	for _, teamName in ipairs(sortedTeams) do
		if query == ""
			or string.find(string.lower(teamName), query, 1, true) then

			addSelectionRow(
				teamName,
				Settings.SelectedTeams[teamName] == true,
				function()
					if Settings.SelectedTeams[teamName] then
						Settings.SelectedTeams[teamName] = nil
					else
						Settings.SelectedTeams[teamName] = true
					end

					refreshSelector()
				end
			)
		end
	end

	updateSelectionStatus()
end

