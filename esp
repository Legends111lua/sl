local function createToggle(text, setting)
	local button = Instance.new("TextButton")
	button.Name = setting
	button.AutoButtonColor = false
	button.BackgroundColor3 = Color3.fromRGB(32, 33, 38)
	button.BorderSizePixel = 0
	button.Size = UDim2.new(1, 0, 0, 30)
	button.Text = ""
	button.Parent = Body

	Instance.new("UICorner", button).CornerRadius = UDim.new(0, 7)

	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Position = UDim2.fromOffset(10, 0)
	label.Size = UDim2.new(1, -60, 1, 0)
	label.Font = Enum.Font.Gotham
	label.Text = text
	label.TextColor3 = Color3.fromRGB(220, 220, 225)
	label.TextSize = 11
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.Parent = button

	local indicator = Instance.new("Frame")
	indicator.AnchorPoint = Vector2.new(1, 0.5)
	indicator.Position = UDim2.new(1, -8, 0.5, 0)
	indicator.Size = UDim2.fromOffset(36, 18)
	indicator.BorderSizePixel = 0
	indicator.Parent = button

	Instance.new("UICorner", indicator).CornerRadius = UDim.new(1, 0)

	local dot = Instance.new("Frame")
	dot.AnchorPoint = Vector2.new(0, 0.5)
	dot.Position = UDim2.new(0, 3, 0.5, 0)
	dot.Size = UDim2.fromOffset(12, 12)
	dot.BorderSizePixel = 0
	dot.Parent = indicator

	Instance.new("UICorner", dot).CornerRadius = UDim.new(1, 0)

	local function render()
		local enabled = Settings[setting]

		indicator.BackgroundColor3 = enabled
			and Color3.fromRGB(70, 180, 105)
			or Color3.fromRGB(58, 60, 67)

		dot.BackgroundColor3 = Color3.fromRGB(235, 235, 240)

		dot.Position = enabled
			and UDim2.new(1, -15, 0.5, 0)
			or UDim2.new(0, 3, 0.5, 0)
	end

	button.Activated:Connect(function()
		Settings[setting] = not Settings[setting]

		if setting == "Enabled" and not Settings.Enabled then
			for _, objects in pairs(EspObjects) do
				hideObjects(objects)
			end
		end

		render()
	end)

	render()
end

