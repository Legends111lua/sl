-- Drag PC + Mobile

local dragging = false
local dragInput
local dragStart
local startPosition

Header.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then

		dragging = true
		dragInput = input
		dragStart = input.Position
		startPosition = Main.Position

		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				dragging = false
				dragInput = nil
			end
		end)
	end
end)

addConnection(UserInputService.InputChanged:Connect(function(input)
	if not dragging then
		return
	end

	local validInput =
		input == dragInput
		or input.UserInputType == Enum.UserInputType.MouseMovement

	if not validInput then
		return
	end

	local delta = input.Position - dragStart

	Main.Position = UDim2.new(
		startPosition.X.Scale,
		startPosition.X.Offset + delta.X,
		startPosition.Y.Scale,
		startPosition.Y.Offset + delta.Y
	)
end))

local lastViewport = Vector2.zero

local function updateHudScale()
	local camera = workspace.CurrentCamera

	if not camera then
		return
	end

	local viewport = camera.ViewportSize

	if viewport == lastViewport then
		return
	end

	lastViewport = viewport

	if viewport.X <= 400 then
		UIScale.Scale = 0.78
	elseif viewport.X <= 600 then
		UIScale.Scale = 0.86
	elseif viewport.X <= 900 then
		UIScale.Scale = 0.94
	else
		UIScale.Scale = 1
	end
end

-- ESP

local renderAccumulator = 0
local statusAccumulator = 0
local visiblePlayers = 0

local RenderConnection
RenderConnection = RunService.RenderStepped:Connect(function(deltaTime)
	renderAccumulator += deltaTime
	statusAccumulator += deltaTime

	updateHudScale()

	if renderAccumulator < UPDATE_INTERVAL then
		return
	end

	renderAccumulator = 0

	if not Settings.Enabled then
		if statusAccumulator >= 0.25 then
			statusAccumulator = 0
			Status.Text = "ESP desativado"
		end

		return
	end

	local camera = workspace.CurrentCamera

	if not camera then
		return
	end

	local localCharacter = LocalPlayer.Character
	local localRoot = localCharacter
		and localCharacter:FindFirstChild("HumanoidRootPart")

	visiblePlayers = 0

	for _, player in ipairs(Players:GetPlayers()) do
		if player == LocalPlayer then
			continue
		end

		local objects = createEsp(player)

		if not objects then
			continue
		end

		local character = player.Character

		local humanoid = character
			and character:FindFirstChildOfClass("Humanoid")

		local root = character
			and character:FindFirstChild("HumanoidRootPart")

		local sameTeam =
			player.Team ~= nil
			and LocalPlayer.Team ~= nil
			and player.Team == LocalPlayer.Team

		if Settings.HideTeam and sameTeam then
			hideObjects(objects)
			continue
		end

		if not character
			or not root
			or not humanoid
			or humanoid.Health <= 0 then

			hideObjects(objects)
			continue
		end

		local rootPoint, onScreen = camera:WorldToViewportPoint(
			root.Position + Vector3.new(0, 2.5, 0)
		)

		if not onScreen or rootPoint.Z <= 0 then
			hideObjects(objects)
			continue
		end

		visiblePlayers += 1

		local color = getPlayerColor(player)

		local distance = 0

		if localRoot then
			distance = math.floor(
				(localRoot.Position - root.Position).Magnitude
			)
		end

		local bounds

		if Settings.Box or Settings.Health then
			bounds = getScreenBounds(character, camera)
		end

		if Settings.Box and bounds then
			objects.BoxOutline.Position = Vector2.new(
				bounds.X,
				bounds.Y
			)

			objects.BoxOutline.Size = Vector2.new(
				bounds.Width,
				bounds.Height
			)

			objects.Box.Position = objects.BoxOutline.Position
			objects.Box.Size = objects.BoxOutline.Size

			objects.Box.Color = color

			objects.BoxOutline.Visible = true
			objects.Box.Visible = true
		else
			objects.BoxOutline.Visible = false
			objects.Box.Visible = false
		end

		if Settings.Health and bounds then
			local maxHealth = math.max(humanoid.MaxHealth, 1)

			local healthRatio = math.clamp(
				humanoid.Health / maxHealth,
				0,
				1
			)

			local healthX = bounds.X - 6

			objects.HealthBackground.From = Vector2.new(
				healthX,
				bounds.Y
			)

			objects.HealthBackground.To = Vector2.new(
				healthX,
				bounds.Bottom
			)

			objects.Health.From = Vector2.new(
				healthX,
				bounds.Bottom
			)

			objects.Health.To = Vector2.new(
				healthX,
				bounds.Bottom - bounds.Height * healthRatio
			)

			objects.Health.Color = Color3.new(
				1 - healthRatio,
				healthRatio,
				0.15
			)

			objects.HealthBackground.Visible = true
			objects.Health.Visible = true
		else
			objects.HealthBackground.Visible = false
			objects.Health.Visible = false
		end

		local info = {}

		if Settings.Name then
			table.insert(
				info,
				player.DisplayName ~= player.Name
					and player.DisplayName .. " (@" .. player.Name .. ")"
					or player.Name
			)
		end

		if Settings.Animal then
			table.insert(
				info,
				tostring(getAnimalName(character))
			)
		end

		if Settings.Distance then
			table.insert(
				info,
				string.format("%dm", distance)
			)
		end

		if Settings.Health then
			table.insert(
				info,
				string.format(
					"%d/%d HP",
					math.ceil(humanoid.Health),
					math.ceil(humanoid.MaxHealth)
				)
			)
		end

		if #info == 0 then
			table.insert(info, player.Name)
		end

		objects.Text.Text = table.concat(info, " | ")
		objects.Text.Color = color

		objects.Text.Size = IS_MOBILE and 12 or 14

		if bounds then
			objects.Text.Position = Vector2.new(
				bounds.X + bounds.Width / 2,
				bounds.Y - 17
			)
		else
			objects.Text.Position = Vector2.new(
				rootPoint.X,
				rootPoint.Y
			)
		end

		objects.Text.Visible = true

		if Settings.Tracer then
			objects.Tracer.From = Vector2.new(
				camera.ViewportSize.X / 2,
				camera.ViewportSize.Y - 2
			)

			if bounds then
				objects.Tracer.To = Vector2.new(
					bounds.X + bounds.Width / 2,
					bounds.Bottom
				)
			else
				objects.Tracer.To = Vector2.new(
					rootPoint.X,
					rootPoint.Y
				)
			end

			objects.Tracer.Color = color
			objects.Tracer.Visible = true
		else
			objects.Tracer.Visible = false
		end
	end

	if statusAccumulator >= 0.25 then
		statusAccumulator = 0

		Status.Text = string.format(
			"ESP ativo • %d visíveis • %s",
			visiblePlayers,
			IS_MOBILE and "Mobile" or "PC"
		)
	end
end)

addConnection(RenderConnection)

addConnection(Players.PlayerRemoving:Connect(function(player)
	removeEsp(player)
end))

local cleaned = false

local function cleanup()
	if cleaned then
		return
	end

	cleaned = true

	for _, connection in ipairs(Connections) do
		pcall(function()
			connection:Disconnect()
		end)
	end

	table.clear(Connections)

	removeAllEsp()

	if ScreenGui then
		ScreenGui:Destroy()
	end

	shared.MMBStandaloneESP_Cleanup = nil
end

shared.MMBStandaloneESP_Cleanup = cleanup
shared.MMBStandaloneESP = {
	Settings = Settings,
	Cleanup = cleanup,
}
